msgstr "Force refresh"

msgid "plugins.generic.googleBooks.openGoogle"
msgstr "Open Google Books"

msgid "plugins.generic.googleBooks.noRecords"
msgstr "No books are tracked yet. Run a catalog synchronization after configuration."

