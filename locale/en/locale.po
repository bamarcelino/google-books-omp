msgstr "Feed username"

msgid "plugins.generic.googleBooks.feedPassword"
msgstr "Feed password"

msgid "plugins.generic.googleBooks.feedPasswordAlreadySet"
msgstr "A password is already stored. Leave this field blank to keep it."

msgid "plugins.generic.googleBooks.feedPasswordDescription"
msgstr "Set a password before enabling the feed. Use alphanumeric credentials for Google automated fetching."

msgid "plugins.generic.googleBooks.behavior"
msgstr "Synchronization behavior"

msgid "plugins.generic.googleBooks.autoSync"
msgstr "Automatically queue synchronization when a published book or its metadata changes"

msgid "plugins.generic.googleBooks.defaultFree"
msgstr "Treat formats without an OMP market price as free of charge"

msgid "plugins.generic.googleBooks.showPublicLink"
msgstr "Show Google Books next to the public book identifiers after a record is discovered"

msgid "plugins.generic.googleBooks.feedEnabled"
msgstr "Enable the full Google publisher feed"

msgid "plugins.generic.googleBooks.validationSample"
msgstr "Initial ONIX validation sample"

msgid "plugins.generic.googleBooks.validationSampleDescription"
msgstr "Select a real published book with an ISBN, title, author(s), publisher/imprint and publication date. The plugin generates the one-time metadata-only ONIX format sample for onix/validate/. Google does not use this sample to enable rights or sales settings."

msgid "plugins.generic.googleBooks.validationBook"
msgstr "Validation book"

msgid "plugins.generic.googleBooks.generateValidation"
msgstr "Generate validation ONIX"

msgid "plugins.generic.googleBooks.validationUrl"
msgstr "Authenticated validation URL"

msgid "plugins.generic.googleBooks.downloadValidation"
msgstr "Download validation ONIX"

msgid "plugins.generic.googleBooks.feedEndpoints"
msgstr "Google automated content fetching endpoints"

msgid "plugins.generic.googleBooks.feedEndpointsDescription"
msgstr "Provide these authenticated top-level URLs to Google when configuring automated content fetching."

