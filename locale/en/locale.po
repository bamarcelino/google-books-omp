msgid "plugins.generic.googleBooks.displayName"
msgstr "Google Books Integration for OMP"

msgid "plugins.generic.googleBooks.description"
msgstr "Synchronizes published OMP books with Google Books and Google Play Books through the official automated content fetching workflow."

msgid "plugins.generic.googleBooks.dashboard"
msgstr "Google Books"

msgid "plugins.generic.googleBooks.dashboardIntro"
msgstr "Discover existing Google Books records, prepare Google-specific ONIX 3.0 feeds, expose current PDF/EPUB/cover files to the Google crawler, and monitor synchronization state."

msgid "plugins.generic.googleBooks.catalogStatus"
msgstr "Catalog status"

msgid "plugins.generic.googleBooks.records"
msgstr "Tracked products"

msgid "plugins.generic.googleBooks.linked"
msgstr "Linked to Google Books"

msgid "plugins.generic.googleBooks.notFound"
msgstr "Not returned by the Google Books API"

