msgstr "Google Books"

msgid "plugins.generic.googleBooks.viewOnGoogleBooks"
msgstr "View on Google Books"

msgid "plugins.generic.googleBooks.viewOnGooglePlay"
msgstr "Get on Google Play Books"

msgid "plugins.generic.googleBooks.defaultWorldwideRightsForFree"
msgstr "Assume worldwide non-exclusive sales rights for free titles when OMP has no Sales Rights entry"

msgid "plugins.generic.googleBooks.defaultWorldwideRightsForFreeDescription"
msgstr "Disabled by default. Enable only if the publisher actually holds worldwide rights. The plugin otherwise requires explicit OMP Sales Rights before exposing a title in the Google rights feed."

msgid "plugins.generic.googleBooks.apiKeyAlreadySet"
msgstr "An API key is already stored. Leave this field blank to keep it."

msgid "plugins.generic.googleBooks.apiKeyDescription"
msgstr "Required for Google Books discovery and verification. It is not required for feed generation. The key is stored by OMP and is never rendered back into this form."

msgid "plugins.generic.googleBooks.message.settingsSaved"
msgstr "Google Books settings were saved."

msgid "plugins.generic.googleBooks.message.syncQueued"
msgstr "Catalog synchronization was queued."

msgid "plugins.generic.googleBooks.message.forceQueued"
msgstr "A forced full catalog refresh was queued."

msgid "plugins.generic.googleBooks.message.bookSyncQueued"
msgstr "Book synchronization was queued."

msgid "plugins.generic.googleBooks.message.validationReady"
msgstr "The validation ONIX was generated successfully."

msgid "plugins.generic.googleBooks.message.invalidCollectionCode"
msgstr "The Google collection code must contain exactly 7 alphanumeric characters. Invisible copy-and-paste spacing is removed automatically."

msgid "plugins.generic.googleBooks.message.invalidFeedCredentials"
msgstr "Google feed username and password must be alphanumeric."

msgid "plugins.generic.googleBooks.message.invalidImprintMap"
msgstr "The imprint map is invalid. Use one Imprint=AB12345 mapping per line."

msgid "plugins.generic.googleBooks.message.feedConfigurationIncomplete"
msgstr "At least one collection code, a feed username and a feed password are required before the full feed can be enabled."

msgid "plugins.generic.googleBooks.message.collectionCodeRequired"
msgstr "Configure at least one valid Google collection code before synchronizing."

msgid "plugins.generic.googleBooks.message.invalidSubmission"
msgstr "The selected OMP submission does not belong to this press."

msgid "plugins.generic.googleBooks.message.validationFailed"
msgstr "The selected book could not produce a valid Google ONIX validation sample. Check its ISBN, title, author(s), publisher/imprint and publication date. If an incident code is shown, consult the server error log for that code."

msgid "plugins.generic.googleBooks.checkGoogleStatus"
msgstr "Check Google status"

msgid "plugins.generic.googleBooks.autoVerifyGoogle"
msgstr "Automatically recheck Google Books after a newly exposed book is not found"

msgid "plugins.generic.googleBooks.autoVerifyGoogleDescription"
msgstr "When enabled, the plugin schedules bounded follow-up ISBN checks after synchronization so the Google Volume ID can be linked after Google processes the feed."

msgid "plugins.generic.googleBooks.message.verifyQueued"
msgstr "A Google Books status check was queued."

msgid "plugins.generic.googleBooks.message.apiKeyRequired"
msgstr "A Google Books API key is required for discovery and verification."

msgid "plugins.generic.googleBooks.message.validationNotSelected"
msgstr "Select and generate a validation book before downloading the ONIX sample."

msgid "plugins.generic.googleBooks.message.csrfExpired"
msgstr "Your session security token expired. Reload the Google Books page and submit the form again."

msgid "plugins.generic.googleBooks.message.operationFailed"
msgstr "The Google Books operation could not be completed. No raw server error was exposed. Use the incident code below to locate the technical error in the server log."

msgid "plugins.generic.googleBooks.message.incidentCode"
msgstr "Diagnostic incident code"

msgid "plugins.generic.googleBooks.feedDisabled"
msgstr "Feed disabled"

msgid "plugins.generic.googleBooks.catalogStatusDescription"
msgstr "Current reconciliation state between the OMP catalog, publisher feed and Google Books."

msgid "plugins.generic.googleBooks.catalogActions"
msgstr "Google Books catalog actions"

msgid "plugins.generic.googleBooks.settingsDescription"
msgstr "Configure the Google Partner account, collection codes, feed access and synchronization behavior for this press."

msgid "plugins.generic.googleBooks.collectionCodeDetected"
msgstr "Value detected"

msgid "plugins.generic.googleBooks.partnerIdDescription"
msgstr "Optional Google Books Partner ID used to narrow verification queries when available."

msgid "plugins.generic.googleBooks.feedActive"
msgstr "Feed active"

msgid "plugins.generic.googleBooks.apiReady"
msgstr "API configured"

msgid "plugins.generic.googleBooks.apiNotConfigured"
msgstr "API not configured"

msgid "plugins.generic.googleBooks.feedReady"
msgstr "Feed ready"

msgid "plugins.generic.googleBooks.feedNotReadyStatus"
msgstr "Feed not configured"

msgid "plugins.generic.googleBooks.publishedInOmp"
msgstr "Books published in OMP"

msgid "plugins.generic.googleBooks.discoveryErrors"
msgstr "Discovery errors"

msgid "plugins.generic.googleBooks.feedIneligible"
msgstr "Not eligible for feed"

msgid "plugins.generic.googleBooks.feedErrors"
msgstr "Feed errors"

msgid "plugins.generic.googleBooks.discoverySection"
msgstr "Google Books discovery"

msgid "plugins.generic.googleBooks.discoverySectionDescription"
msgstr "Reconcile every published OMP ISBN against the public Google Books API. This does not require the publisher feed, does not send ONIX or files, and stores an unambiguous Volume ID immediately for display on the public book page."

msgid "plugins.generic.googleBooks.discoverCatalog"
msgstr "Discover catalogue in Google Books"

msgid "plugins.generic.googleBooks.discoveryNeedsApiKey"
msgstr "Save a Google Books API key to enable catalogue discovery."

msgid "plugins.generic.googleBooks.feedSyncSection"
msgstr "Feed synchronization"

msgid "plugins.generic.googleBooks.feedSyncSectionDescription"
msgstr "Prepare ONIX, rights and files for Google's automated content fetcher. This becomes available only after the feed is configured and enabled."

msgid "plugins.generic.googleBooks.synchronizeFeed"
msgstr "Update Google feed"

msgid "plugins.generic.googleBooks.feedNotReadyHelp"
msgstr "Configure a collection code, alphanumeric crawler credentials and enable the feed before publishing content to Google."

msgid "plugins.generic.googleBooks.apiSettings"
msgstr "Google Books API"

msgid "plugins.generic.googleBooks.apiSettingsDescription"
msgstr "The API is used only to discover and verify existing volumes. It can be used before Automated Content Fetching is configured."

msgid "plugins.generic.googleBooks.autoDiscovery"
msgstr "Automatically discover a book in Google Books when it is published or its metadata changes"

msgid "plugins.generic.googleBooks.autoDiscoveryDescription"
msgstr "Runs an ISBN lookup in the background and updates the Google Volume ID and public link when there is one unambiguous match."

msgid "plugins.generic.googleBooks.showPublicLinkDescription"
msgstr "After a Volume ID is found, the public book page displays Google Books, ISBN and Volume ID with the bibliographic details."

msgid "plugins.generic.googleBooks.feedSettings"
msgstr "Automated Content Feed"

msgid "plugins.generic.googleBooks.feedSettingsDescription"
msgstr "Configure the channel Google's crawler will use to fetch ONIX, PDF/EPUB and covers. These credentials are created by the publisher and are not Google account credentials."

msgid "plugins.generic.googleBooks.feedCredentialsDescription"
msgstr "Create a dedicated username and password for the crawler. Google requires letters and numbers only. The generator creates compatible credentials; the password is stored only as a hash."

msgid "plugins.generic.googleBooks.generateCredentials"
msgstr "Generate secure credentials"

msgid "plugins.generic.googleBooks.feedEnabledDescription"
msgstr "Enable only after configuring the collection code and the credentials that will be supplied to Google."

msgid "plugins.generic.googleBooks.behaviorDescription"
msgstr "Configure feed-delivery behavior. API discovery remains independent."

msgid "plugins.generic.googleBooks.booksDescription"
msgstr "Local records created by ISBN discovery or feed preparation. A book may be linked to Google even when it is not eligible for the feed."

msgid "plugins.generic.googleBooks.discoverNow"
msgstr "Discover now"

msgid "plugins.generic.googleBooks.skipped"
msgstr "Published books with no detectable ISBN"

msgid "plugins.generic.googleBooks.runDetails"
msgstr "Run details"

msgid "plugins.generic.googleBooks.message.apiSettingsSaved"
msgstr "Google Books API settings were saved."

msgid "plugins.generic.googleBooks.message.feedSettingsSaved"
msgstr "Google feed settings were saved."

msgid "plugins.generic.googleBooks.message.behaviorSettingsSaved"
msgstr "Synchronization behavior was saved."

msgid "plugins.generic.googleBooks.message.discoveryQueued"
msgstr "Google Books catalogue discovery was queued in batches. The feed does not need to be enabled."

msgid "plugins.generic.googleBooks.message.feedSyncQueued"
msgstr "Google feed update was queued."

msgid "plugins.generic.googleBooks.message.bookDiscoveryQueued"
msgstr "Google Books discovery for this book was queued."

msgid "plugins.generic.googleBooks.message.feedNotReady"
msgstr "The feed is not ready. Configure a collection code, alphanumeric username and password, then enable the feed."

