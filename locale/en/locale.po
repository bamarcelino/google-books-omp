msgid "plugins.generic.googleBooks.deliverNow"
msgstr "Deliver now"

msgid "plugins.generic.googleBooks.deliveryDeleted"
msgstr "Removed stale files"

msgid "plugins.generic.googleBooks.deliveryEnabledDescription"
msgstr "Enables the selected Google delivery workflow for this press. Configuration can be saved while disabled."

msgid "plugins.generic.googleBooks.deliveryMode"
msgstr "Delivery method"

msgid "plugins.generic.googleBooks.deliveryModeDescription"
msgstr "Choose how Google retrieves the generated ONIX metadata and book files. HTTP/HTTPS is pull-based; SFTP/FTP/GCS options stage or push files to the configured destination."

msgid "plugins.generic.googleBooks.deliveryNotReady"
msgstr "Delivery is not ready"

msgid "plugins.generic.googleBooks.deliveryOperations"
msgstr "Delivery operations"

msgid "plugins.generic.googleBooks.deliveryOperationsDescription"
msgstr "Test the selected destination or queue an incremental/forced delivery. Large deliveries run in the OMP background queue."

msgid "plugins.generic.googleBooks.deliveryPayloads"
msgstr "Files and data to deliver"

msgid "plugins.generic.googleBooks.deliveryReady"
msgstr "The selected delivery configuration is ready."

msgid "plugins.generic.googleBooks.deliverySettings"
msgstr "Delivery and file retrieval"

msgid "plugins.generic.googleBooks.deliverySettingsDescription"
msgstr "Configure the collection codes, Google retrieval method, destination, and the exact metadata/content trees that this press will expose or upload."

msgid "plugins.generic.googleBooks.deliveryUploaded"
msgstr "Uploaded files"

msgid "plugins.generic.googleBooks.forceDelivery"
msgstr "Force complete delivery"

msgid "plugins.generic.googleBooks.ftpPassive"
msgstr "Passive FTP mode"

msgid "plugins.generic.googleBooks.ftpTls"
msgstr "Use explicit TLS/FTPS when supported"

msgid "plugins.generic.googleBooks.gcsBucket"
msgstr "Bucket name"

msgid "plugins.generic.googleBooks.gcsDescription"
msgstr "The plugin writes the managed Google Books tree to a Google Cloud Storage bucket. Grant the Google-provided reader service account access after Google supplies it."

msgid "plugins.generic.googleBooks.gcsGoogleReaderServiceAccount"
msgstr "Google reader service account"

msgid "plugins.generic.googleBooks.gcsGoogleReaderServiceAccountDescription"
msgstr "Non-secret service account supplied by Google for the automated fetch. Grant it read/list access to the bucket or prefix."

msgid "plugins.generic.googleBooks.gcsPrefix"
msgstr "Object prefix"

msgid "plugins.generic.googleBooks.gcsWriterServiceAccount"
msgstr "Publisher writer service-account JSON"

msgid "plugins.generic.googleBooks.gcsWriterServiceAccountDescription"
msgstr "Service-account JSON used only by this OMP installation to upload objects to your bucket. It is encrypted at rest and never displayed again."

msgid "plugins.generic.googleBooks.googleAuthentication"
msgstr "Google authentication"

msgid "plugins.generic.googleBooks.googleAuthenticationDescription"
msgstr "Manage the Google Books API credential, Partner Center identifier, crawler authentication, and secure credentials used by remote delivery methods."

msgid "plugins.generic.googleBooks.googleDirectoryLayout"
msgstr "Google Books directory layout"

msgid "plugins.generic.googleBooks.googleDirectoryLayoutDescription"
msgstr "The same logical tree is generated for HTTP, SFTP, FTP, Google Cloud Storage, and protected local export."

msgid "plugins.generic.googleBooks.googleSftpDescription"
msgstr "Use the SFTP dropbox credentials supplied by Google. OMP pushes only new or modified managed files and never needs inbound HTTP Basic authentication."

msgid "plugins.generic.googleBooks.hostKeyFingerprint"
msgstr "SSH host-key fingerprint"

msgid "plugins.generic.googleBooks.hostKeyFingerprintDescription"
msgstr "Optional SHA256 or MD5 fingerprint used to pin the SFTP server host key when supported by libcurl."

msgid "plugins.generic.googleBooks.httpCrawlerAuthentication"
msgstr "HTTP/HTTPS crawler authentication"

msgid "plugins.generic.googleBooks.httpCrawlerAuthenticationDescription"
msgstr "Credentials used only when Google fetches the virtual OMP feed over HTTP/HTTPS. They are not used by SFTP, FTP or Google Cloud Storage delivery."

msgid "plugins.generic.googleBooks.httpPullDescription"
msgstr "Google periodically fetches the authenticated virtual ONIX and eBook directories directly from this OMP installation. The protocol follows the public press URL."

msgid "plugins.generic.googleBooks.lastDelivery"
msgstr "Latest file delivery"

msgid "plugins.generic.googleBooks.localExportDescription"
msgstr "Creates the complete managed tree inside OMP files_dir/googleBooksDelivery/<context>. This is a protected fallback for manual transfer or external automation; Google cannot fetch it directly unless another service publishes it."

msgid "plugins.generic.googleBooks.modeGcs"
msgstr "Google Cloud Storage bucket"

msgid "plugins.generic.googleBooks.modeGoogleSftp"
msgstr "Google-provided SFTP Dropbox"

msgid "plugins.generic.googleBooks.modeHttpPull"
msgstr "HTTP/HTTPS automated fetch from OMP"

msgid "plugins.generic.googleBooks.modeLocalExport"
msgstr "Protected local export"

msgid "plugins.generic.googleBooks.modePublisherFtp"
msgstr "Publisher-managed FTP/FTPS server"

msgid "plugins.generic.googleBooks.modePublisherSftp"
msgstr "Publisher-managed SFTP server"

msgid "plugins.generic.googleBooks.payloadEbooks"
msgstr "EPUB / PDF / cover files"

msgid "plugins.generic.googleBooks.payloadOnixFull"
msgstr "Bibliographic ONIX - full"

msgid "plugins.generic.googleBooks.payloadOnixRights"
msgstr "Rights and sales ONIX - rights"

msgid "plugins.generic.googleBooks.payloadValidation"
msgstr "ONIX validation sample"

msgid "plugins.generic.googleBooks.publisherFtpDescription"
msgstr "OMP stages the generated tree on an FTP server that Google can fetch. TLS/FTPS can be enabled when the server and PHP support it."

msgid "plugins.generic.googleBooks.publisherSftpDescription"
msgstr "OMP stages the generated tree on your SFTP server; Google can then fetch the same directory structure from that server."

msgid "plugins.generic.googleBooks.remoteAuthentication"
msgstr "Remote delivery authentication"

msgid "plugins.generic.googleBooks.remoteAuthenticationDescription"
msgstr "Store credentials for Google SFTP Dropbox, publisher SFTP/FTP and Google Cloud Storage. Reversible secrets are encrypted with the OMP application key and are never shown back in the dashboard."

msgid "plugins.generic.googleBooks.remoteHost"
msgstr "Server host"

msgid "plugins.generic.googleBooks.remotePassword"
msgstr "Password"

msgid "plugins.generic.googleBooks.remotePort"
msgstr "Port"

msgid "plugins.generic.googleBooks.remoteRoot"
msgstr "Remote root directory"

msgid "plugins.generic.googleBooks.remoteUsername"
msgstr "Username"

msgid "plugins.generic.googleBooks.secretAlreadyStored"
msgstr "A credential is already stored. Leave this field blank to keep it."

msgid "plugins.generic.googleBooks.secretLeaveBlank"
msgstr "Leave blank to keep the existing value or until Google supplies the credential."

msgid "plugins.generic.googleBooks.secretSecurityDescription"
msgstr "Passwords, SSH private keys, passphrases and service-account JSON are encrypted at rest with OMP general.app_key. HTTP crawler passwords remain one-way password hashes. Secret values are never included in diagnostics."

msgid "plugins.generic.googleBooks.sftpAuthMode"
msgstr "SFTP authentication"

msgid "plugins.generic.googleBooks.sftpKeyAuth"
msgstr "SSH private key"

msgid "plugins.generic.googleBooks.sftpKeyPassphrase"
msgstr "Private-key passphrase"

msgid "plugins.generic.googleBooks.sftpPasswordAuth"
msgstr "Username and password"

msgid "plugins.generic.googleBooks.sftpPrivateKey"
msgstr "SSH private key"

msgid "plugins.generic.googleBooks.sftpPrivateKeyDescription"
msgstr "Paste a PEM/OpenSSH private key only when the SFTP endpoint requires key authentication. The key is encrypted at rest."

msgid "plugins.generic.googleBooks.tabAuthentication"
msgstr "Authentication"

msgid "plugins.generic.googleBooks.tabCatalog"
msgstr "Catalog"

msgid "plugins.generic.googleBooks.tabDelivery"
msgstr "Delivery & files"

msgid "plugins.generic.googleBooks.tabOverview"
msgstr "Overview"

msgid "plugins.generic.googleBooks.testConnection"
msgstr "Test connection"

msgid "plugins.generic.googleBooks.transportCapabilities"
msgstr "Server transport capabilities"

msgid "plugins.generic.googleBooks.transportCapabilitiesDescription"
msgstr "Runtime check for the PHP extensions and libcurl protocols required by each supported delivery path."

msgid "plugins.generic.googleBooks.message.crawlerAuthSaved"
msgstr "HTTP/HTTPS crawler authentication was saved."

msgid "plugins.generic.googleBooks.message.deliveryQueued"
msgstr "Google Books delivery was queued in the OMP background worker."

msgid "plugins.generic.googleBooks.message.deliverySettingsSaved"
msgstr "Delivery and file retrieval settings were saved."

msgid "plugins.generic.googleBooks.message.deliveryTestFailed"
msgstr "The selected delivery connection test failed. Review the diagnostic below."

msgid "plugins.generic.googleBooks.message.deliveryTestSucceeded"
msgstr "The selected delivery connection test succeeded."

msgid "plugins.generic.googleBooks.message.transportAuthSaved"
msgstr "Remote delivery credentials were saved securely."
