msgstr "Google configuration"

msgid "plugins.generic.googleBooks.collectionCode"
msgstr "Default collection code"

msgid "plugins.generic.googleBooks.collectionCodeDescription"
msgstr "The 7-character alphanumeric code shown under Book Catalog > Advanced > Manage templates. Example: AB12345."

msgid "plugins.generic.googleBooks.imprintMap"
msgstr "Imprint to collection code map"

msgid "plugins.generic.googleBooks.imprintMapDescription"
msgstr "Optional. One mapping per line, for example: My Imprint=AB12345. This supports publishers with multiple Google templates/imprints."

msgid "plugins.generic.googleBooks.apiKey"
msgstr "Google Books API key"

msgid "plugins.generic.googleBooks.partnerId"
msgstr "Google Books Partner ID"

